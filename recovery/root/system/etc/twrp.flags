# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point          fstype  device                                        device2              flags

/metadata              f2fs    /dev/block/by-name/metadata                                        flags=display="Metadata";backup=1
/data                  f2fs    /dev/block/by-name/userdata                                        flags=fileencryption=aes-256-cts:aes-256-cts:v2+inlinecrypt_optimised,keydirectory=/metadata/vold/metadata_encryption,fsverity
/storage               f2fs    /data/media/0                                                      flags=backup=1;display="Internal Storage";usermrf;fsflags="bind,utf8";removable

# Boot
/boot                  emmc    /dev/block/by-name/boot                                            flags=backup=1;display="boot";slotselect;flashimg=1
/init_boot             emmc    /dev/block/by-name/init_boot                                       flags=backup=1;display="init_boot";slotselect;flashimg=1
/dtbo                  emmc    /dev/block/by-name/dtbo                                            flags=backup=1;display="dtbo";slotselect;flashimg=1
/vendor_boot           emmc    /dev/block/by-name/vendor_boot                                     flags=backup=1;display="vendor_boot";slotselect;flashimg=1
/vbmeta                emmc    /dev/block/by-name/vbmeta                                          flags=backup=1;display="vbmeta";slotselect;flashimg=1
/vbmeta_system         emmc    /dev/block/by-name/vbmeta_system                                   flags=backup=1;display="vbmeta_system";slotselect;flashimg=1
/logo                  emmc    /dev/block/by-name/logo                                            flags=backup=1;display="logo";slotselect;flashimg=1
/misc                  emmc    /dev/block/by-name/misc                                            flags=backup=1;display="misc";flashimg=1

# Persistent Firmware & Properties
/persist               ext4    /dev/block/by-name/persist                                         flags=display="persist";backup=0
/persist_image         emmc    /dev/block/by-name/persist                                         flags=display="persist";flashimg=1

# Firmware partitions
/mnt/vendor/tzapp      ext4    /dev/block/by-name/tzapp_a                                         flags=backup=1;display="tzapp"

# Removable storage
/usb_otg               auto    /dev/block/sdd                                /dev/block/sdd1      flags=display="USB-Storage";storage;wipeingui;removable
